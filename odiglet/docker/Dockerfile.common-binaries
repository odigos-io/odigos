# Builds CSI driver, deviceplugin, and grpc_health_probe.
# Separated from Dockerfile.builder so odiglet source changes do not invalidate
# these layers when only go.mod / deviceplugin sources change.
# Bake context must be the odigos repo root.

ARG ODIGLET_BASE_IMAGE=registry.odigos.io/odiglet-base:v1.20

FROM --platform=$BUILDPLATFORM ${ODIGLET_BASE_IMAGE} AS odiglet-common-binaries
ENV GOTOOLCHAIN=auto

ARG TARGETARCH
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.55
# Download grpc_health_probe before COPY so module/source changes do not invalidate it.
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        GRPC_ARCH="arm64"; \
    else \
        GRPC_ARCH="amd64"; \
    fi && \
    wget -O /tmp/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-${GRPC_ARCH} && \
    chmod +x /tmp/grpc_health_probe

######### Device Plugin #########
WORKDIR /go/src/github.com/odigos-io/odigos
COPY common/ common/
WORKDIR /go/src/github.com/odigos-io/odigos/deviceplugin
COPY deviceplugin/ .
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg,sharing=locked \
    GOOS=linux GOARCH=$TARGETARCH go build -o deviceplugin ./cmd

######### CSI Driver #########
WORKDIR /go/src/github.com/odigos-io/odigos
COPY api/ api/
COPY k8sutils/ k8sutils/
COPY procdiscovery/ procdiscovery/
COPY opampserver/ opampserver/
COPY instrumentation/ instrumentation/
COPY distros/ distros/
WORKDIR /go/src/github.com/odigos-io/odigos/odiglet
COPY odiglet/ .
ARG LD_FLAGS
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg,sharing=locked \
    GOOS=linux GOARCH=$TARGETARCH go build -ldflags="${LD_FLAGS}" -o odigos-csi-driver ./cmd/csi-driver
