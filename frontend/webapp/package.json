{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "check-peer-dependencies --runOnlyOnRootDependencies",
    "dev": "next dev --turbopack",
    "prebuild": "rm -rf out .next",
    "build": "next build --turbopack",
    "build:analyze": "ANALYZE=true next build --turbopack",
    "postbuild": "mkdir -p out && touch out/.keep",
    "back:build": "cd .. && go build -o odigos-backend",
    "back:start": "cd .. && ./odigos-backend --port 8085 --debug --address 0.0.0.0",
    "lint": "next lint",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "@apollo/client": "^4.2.9",
    "@odigos/ui-kit": "0.0.285",
    "graphql": "^16.14.2",
    "next": "15.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.2",
    "rxjs": "^7.8.2",
    "styled-components": "6.4.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.5.4",
    "check-peer-dependencies": "^4.3.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "flatted": "3.4.2",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3",
    "postcss": "^8.5.18"
  }
}
